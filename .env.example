# Copy this file to .env (local dev) and fill in real values.
# Never commit the actual .env file — it is gitignored.

# MongoDB Atlas connection string (includes database name), e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/calmpanion?retryWrites=true&w=majority
DATABASE_URL=""

# Long random secret used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Base URL used to build links (e.g. password reset emails) sent to users.
# Use your Vercel deployment URL in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional: Gmail credentials for sending password-reset emails via nodemailer.
# If left unset, reset links are logged to the server console instead (dev only).
EMAIL_USER=""
EMAIL_PASS=""
